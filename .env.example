# Korak Digitals Frontend (korak-web) Environment Variables Template
# Copy to .env.local for local development. Never commit secret credentials.

# Production Backend API URL
NEXT_PUBLIC_API_URL=https://backend.korakdigital.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://backend.korakdigital.com

# Canonical Site URL (production domain is OPEN; defaults to http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy App URL alias
NEXT_PUBLIC_APP_URL=http://localhost:3000
